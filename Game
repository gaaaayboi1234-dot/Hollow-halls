<div id="vig"></div>
<div id="hud">Fuses 0/4</div>
<div id="msg"></div>
<div id="look"></div>
<div id="stick"><div id="knob"></div></div>
<div id="stm"><i id="stmf"></i></div>
<button class="bt" id="bs">Sprint</button><button class="bt" id="bl">Light</button><button class="bt" id="ba">Hide</button>
<button id="gear" aria-label="Admin">⚙</button>
<div id="adm" class="hide"><div class="box"><h2>Admin</h2>
<div id="lock" class="box" style="border:0;padding:0;width:auto"><input id="ac" type="password" placeholder="Code" autocomplete="off"><button id="al">Unlock</button></div>
<div id="atools" class="box hide" style="border:0;padding:0;width:auto"><label><input type="checkbox" id="god"> God mode</label><label><input type="checkbox" id="inf"> Infinite stamina</label><label>Monster speed <input type="range" id="smr" min="0" max="3" step=".1" value="1"></label><button id="gf">Give fuse</button><button id="ga">Summon allies</button><button id="gd">Teleport to door</button><button id="gk">Banish monster</button></div>
<button id="ax">Close</button></div></div>
<div id="ov"><h1 id="t">Hollow Hall</h1><p id="p"></p><div id="dif"><button data-d="e">Easy</button><button data-d="n" class="on">Normal</button><button data-d="h">Nightmare</button></div><button id="go">Enter</button></div>
