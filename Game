  if(run&&!adm.inf){stam=Math.max(0,stam-dt*.3);if(stam<=0)tired=1}else{stam=Math.min(1,stam+dt*.2);if(stam>.3)tired=0}
  $('stmf').style.width=stam*100+'%';
  var dx=(fx*iz+rx*ix)*sp*dt,dz=(fz*iz+rz*ix)*sp*dt;
  if(!hid){if(!hit(px+dx,pz))px+=dx;if(!hit(px,pz+dz))pz+=dz}
  walk+=m*dt*8;
  var d=Math.hypot(px-ex,pz-ez),near=Math.max(0,1-d/12);
  cam.position.set(px+(Math.random()-.5)*near*.03,(hid?1.2:1.6)+Math.sin(walk)*.04*m,pz+(Math.random()-.5)*near*.03);
  cam.rotation.set(pitch,yaw,0,'YXZ');
  // enemy
  var ec=cellAt(ex,ez),pc=cellAt(px,pz),chase=!hid&&d<(run?26:18),tgt;
  if(chase)tgt=pc;else{if(wt<0||ec===wt)wt=rnd(W*H);tgt=wt}
  if(tgt!==ftgt){field=dist(tgt);ftgt=tgt}
  var seen=d<26&&((ex-px)*fx+(ez-pz)*fz)/d>.55&&clear(px,pz,ex,ez);
  var spd=(1.6+fuses*.45)*SM*adm.sm*(seen?.1:1)*(stun>0?.25:1)*(dead1?0:1),tx,tz;
  if(ec===tgt){tx=px;tz=pz;if(!chase)wt=-1}
  else{var best=ec,bd=field[ec];nbrs(ec).forEach(function(n){if(field[n]>=0&&field[n]<bd){bd=field[n];best=n}});tx=cx(best);tz=cz(best)}
  var vx=tx-ex,vz=tz-ez,vm=Math.hypot(vx,vz)||1,stp=Math.min(vm,spd*dt);ex+=vx/vm*stp;ez+=vz/vm*stp;
  en.position.set(ex,0,ez);en.rotation.y=Math.atan2(px-ex,pz-ez);en.rotation.z=Math.sin(performance.now()/400)*.04;
  eyeM.color.setHex(seen?0x661010:0xff2a2a);
  fl.intensity=(lightOn&&!hid?1.7:0)*(d<7&&Math.random()<.12?.15:1);
  $('vig').style.opacity=Math.min(.85,near*.9);
  heart-=dt;if(heart<=0){heart=Math.max(.35,Math.min(1.3,d/16));tone(60,38,.16,.28+near*.3);setTimeout(function(){tone(55,35,.14,.2+near*.25)},170)}
  if(!adm.god&&!dead1&&d<(hid?.6:1.1)){tone(900,120,.6,.35,'sawtooth');return over('It found you','You collected '+fuses+' of '+NF+' fuses.','Try again')}
  // items
  stun-=dt;fs-=dt;
  if(!dead1&&d<16&&fs<=0){fs=.5+d*.03;tone(95,45,.12,Math.min(.45,2.4/d),'square',((ex-px)*rx+(ez-pz)*rz)/d)}
  var nl=0;lockers.forEach(function(k){if(Math.hypot(px-k.x,pz-k.z)<2)nl=1});var ab=$('ba');ab.style.display=(nl||hid)?'block':'none';ab.textContent=hid?'Leave':'Hide';
  if(e2on){var p2=cellAt(px,pz);if(p2!==e2c){f2=dist(p2);e2c=p2}var d2=Math.hypot(px-e2.position.x,pz-e2.position.z);
    if(!lightOn&&!hid&&d2<24)walkTo(e2.position,f2,p2,px,pz,3.1*SM*adm.sm,dt);
    e2.rotation.y=Math.atan2(px-e2.position.x,pz-e2.position.z);
    if(!adm.god&&!hid&&d2<1){tone(900,120,.6,.35,'sawtooth');return over('It moved in the dark','Keep your light on when it is near.','Try again')}}
  if(allies.length&&!dead1){var ecl=cellAt(ex,ez);if(ecl!==atg){afield=dist(ecl);atg=ecl}var inR=[];
    allies.forEach(function(a,i){var dd=Math.hypot(ex-a.position.x,ez-a.position.z);if(dd<2.2)inR.push(a);else walkTo(a.position,afield,ecl,ex,ez,3.6,dt);a.position.y=Math.sin(performance.now()/300+i)*.08});
    if(inR.length){stun=.3;mhp-=inR.length*18*dt;swat-=dt;if(swat<=0){swat=4.5;var v=inR[0];scene.remove(v);allies.splice(allies.indexOf(v),1);tone(160,50,.4,.3,'sawtooth');say('It destroyed one of them!')}}
    if(mhp<=0){dead1=1;en.visible=false;ex=ez=-99;say('The thing falls apart. Get to the door.')}}
  var tm=performance.now()/1000;
  for(var i=items.length-1;i>=0;i--){var o=items[i];o.position.y=1+Math.sin(tm*2+i)*.1;
    if(Math.hypot(px-o.position.x,pz-o.position.z)<1){grp.remove(o);items.splice(i,1);fuses++;$('hud').textContent='Fuses '+fuses+'/'+NF;tone(520,1040,.25,.25,'triangle');
      if(fuses===NF){doorM.material.color.setHex(0x2fd45a);doorM.userData.l.color.setHex(0x30ff70);summon()}else say('Fuse found. It moves faster now.')}}
  if(Math.hypot(px-cx(exitC),pz-cz(exitC))<1.5){if(fuses===NF){tone(300,900,.8,.3,'triangle');over('You escaped','Hollow Hall lets you go. This time.','Play again')}else if(!update.w){update.w=1;say((NF-fuses)+' fuse'+(NF-fuses>1?'s':'')+' missing.');setTimeout(function(){update.w=0},2500)}}
}
var last=0;
function frame(t){var dt=Math.min(.05,(t-(last||t))/1000);last=t;if(state==='play'&&!paused)update(dt);rd.render(scene,cam);requestAnimationFrame(frame)}
build();state='menu';requestAnimationFrame(frame);
})();
</script>
